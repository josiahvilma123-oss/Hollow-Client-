{
	"schemaVersion": 1,
	"id": "hollow",
	"version": "${version}",
	"name": "Holo",
	"description": "Holo: a dark-fantasy Fabric client with visuals, detection, custom skies, character cosmetics and an animated menu.",
	"authors": ["Holo"],
	"license": "All-Rights-Reserved",
	"environment": "client",
	"icon": "assets/hollow/icon.png",
	"accessWidener": "hollow.accesswidener",
	"entrypoints": {
		"client": ["dev.hollow.HollowClient"]
	},
	"mixins": ["hollow.mixins.json"],
	"depends": {
		"fabricloader": ">=0.17.3",
		"minecraft": "~${minecraft_version}",
		"java": ">=21",
		"fabric-api": ">=0.141.0"
	},
	"breaks": {
		"optifabric": "*"
	}
}
